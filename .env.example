# Nexus Core Connector Environment Variables

# Gemini API Key (Required for AI features in Agent Screen)
GEMINI_API_KEY=

# ESL Configuration (FreeSwitch Event Socket Layer)
ESL_HOST=127.0.0.1
ESL_PORT=8021
ESL_PASSWORD=ClueCon

# Mock Mode (Set to true to simulate ESL/FreeSwitch for development)
MOCK_ESL=false

# Database Configuration (PostgreSQL)
# Nota: En el entorno de previsualización se utiliza un fallback en memoria si no se detecta DB.
DB_HOST=localhost
DB_PORT=5432
DB_USER=nexus_admin
DB_PASSWORD=NexusPass2026!
DB_NAME=nexus_db

# Keycloak Authentication
VITE_KEYCLOAK_URL=https://keycloak.nexus-core.com
VITE_KEYCLOAK_REALM=nexus-core
VITE_KEYCLOAK_CLIENT_ID=nexus-core-pro
KEYCLOAK_CLIENT_SECRET=

# Node Environment
NODE_ENV=production

# WhatsApp Business API
WHATSAPP_VERIFY_TOKEN=nexus_token_2026
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v18.0

# TikTok Business API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_VERIFY_TOKEN=nexus_tiktok_token_2026

# Facebook Messenger & Instagram (Meta Graph API)
META_VERIFY_TOKEN=nexus_meta_token_2026
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
